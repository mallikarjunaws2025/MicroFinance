@model IEnumerable<TestApp.VModels.BranchWithManagerViewModel>

@{
    Layout = "~/Views/Shared/_LayoutPage_New.cshtml";
    ViewBag.Title = "Branch Management";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-building me-2"></i>Branch Management
                        </h4>
                        <div class="btn-group">
                            <a href="@Url.Action("CreateBranch_New", "Staff")" class="btn btn-light btn-sm">
                                <i class="fas fa-plus me-1"></i>Add Branch
                            </a>
                            <button type="button" class="btn btn-outline-light btn-sm" onclick="exportData()">
                                <i class="fas fa-file-excel me-1"></i>Export
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card bg-primary text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-building fa-2x mb-2"></i>
                                        <h4>@Model.Count()</h4>
                                        <p class="mb-0">Total Branches</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-success text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-map-marker-alt fa-2x mb-2"></i>
                                        <h4>@Model.Select(b => b.City).Distinct().Count()</h4>
                                        <p class="mb-0">Cities</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-flag fa-2x mb-2"></i>
                                        <h4>@Model.Select(b => b.State).Distinct().Count()</h4>
                                        <p class="mb-0">States</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-user-tie fa-2x mb-2"></i>
                                        <h4>@Model.Count(b => b.HasManager)</h4>
                                        <p class="mb-0">With Manager</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <input type="text" class="form-control" id="searchInput" placeholder="Search branches...">
                                    <small class="text-muted mt-1" id="resultCount">Showing all branches</small>
                                </div>
                                <div class="col-md-6 text-end">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearFilter()">
                                        <i class="fas fa-times me-1"></i>Clear
                                    </button>
                                    <button type="button" class="btn btn-outline-info btn-sm" onclick="testStaffList()" title="Test Staff Dropdown">
                                        <i class="fas fa-bug me-1"></i>Test Staff
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover" id="branchTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Branch ID</th>
                                        <th>Code</th>
                                        <th>Branch Name</th>
                                        <th>Open Date</th>
                                        <th>Address</th>
                                        <th>City</th>
                                        <th>State</th>
                                        <th>PIN Code</th>
                                        <th>Branch Manager</th>
                                        <th class="text-center" style="min-width: 160px;"><i class="fas fa-cogs me-1"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var branch in Model)
                                    {
                                        <tr>
                                            <td>@branch.BranchID</td>
                                            <td>
                                                <span class="badge bg-primary">@branch.BranchCode</span>
                                            </td>
                                            <td>
                                                <div class="fw-bold">@(branch.BranchName ?? "Unknown")</div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(branch.OpenDate))
                                                {
                                                    <span class="text-muted">@branch.OpenDate</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="text-truncate" style="max-width: 200px;" title="@branch.BAddress">
                                                    @(string.IsNullOrEmpty(branch.BAddress) ? "Not provided" : branch.BAddress)
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@(branch.City ?? "Unknown")</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@(branch.State ?? "Unknown")</span>
                                            </td>
                                            <td>
                                                <code class="bg-light text-dark px-2 py-1 rounded">
                                                    @(branch.PinCode != null ? branch.PinCode.ToString() : "000000")
                                                </code>
                                            </td>
                                            <td>
                                                @if (branch.HasManager)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-user-tie me-1"></i>@branch.ManagerName
                                                    </span>
                                                    <small class="text-muted d-block">(ID: @branch.ManagerID)</small>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fas fa-user-slash me-1"></i>No Manager
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="editBranch(@branch.BranchID)" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteBranch(@branch.BranchID, '@(branch.BranchName != null ? branch.BranchName.Replace("'", "\\'") : "")')" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-building fa-4x text-muted mb-3"></i>
                            <h5>No Branches Found</h5>
                            <p class="text-muted">No branch data available to display.</p>
                            <a href="@Url.Action("CreateBranch_New", "Staff")" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Add First Branch
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    console.log('BranchList functionality loaded');
    
    // Search functionality
    $('#searchInput').on('keyup input', function() {
        filterTable();
    });
});

function filterTable() {
    var input, filter, table, tr, td, i, j, txtValue;
    input = document.getElementById("searchInput");
    filter = input.value.toUpperCase();
    table = document.getElementById("branchTable");
    tr = table.getElementsByTagName("tr");
    var visibleRows = 0;

    for (i = 1; i < tr.length; i++) {
        tr[i].style.display = "none";
        td = tr[i].getElementsByTagName("td");
        for (j = 0; j < td.length; j++) {
            if (td[j]) {
                txtValue = td[j].textContent || td[j].innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                    visibleRows++;
                    break;
                }
            }
        }
    }
    
    console.log('Filtered results:', visibleRows, 'rows visible');
    
    // Update result counter
    var resultText = visibleRows === 1 ? 'Showing 1 branch' : 'Showing ' + visibleRows + ' branches';
    document.getElementById('resultCount').textContent = resultText;
}

function clearFilter() {
    document.getElementById("searchInput").value = "";
    filterTable();
    document.getElementById('resultCount').textContent = 'Showing all branches';
}

function testStaffList() {
    console.log('Testing staff list API...');
    
    $.ajax({
        url: '/Staff/GetStaffList',
        type: 'GET',
        success: function(data) {
            console.log('Staff list response:', data);
            console.log('Number of staff members:', data ? data.length : 0);
            
            if (data && data.length > 0) {
                alert('Staff list loaded successfully! Found ' + data.length + ' staff members. Check console for details.');
            } else {
                alert('No staff members found in the database. Please add some staff first.');
            }
        },
        error: function(xhr, status, error) {
            console.error('Staff list error:', error, xhr.responseText);
            alert('Error loading staff list: ' + error);
        }
    });
}

function exportData() {
    alert("Export functionality will be implemented soon!");
}

function viewBranch(id) {
    alert("View branch " + id + " - functionality to be implemented");
}

function editBranch(branchId) {
    $('#editBranchId').val(branchId);
    
    // Show loading in form fields
    $('#editBranchCode').val('Loading...');
    $('#editBranchName').val('Loading...');
    $('#editOpenDate').val('');
    $('#editBranchAddress').val('Loading...');
    $('#editCity').val('Loading...');
    $('#editState').val('Loading...');
    $('#editPinCode').val('');
    
    // Store branch ID for later use
    $('#editBranchModal').data('branchId', branchId);
    
    // Show modal (this will trigger loadStaffList)
    $('#editBranchModal').modal('show');
}

// Handle edit button clicks with data attributes
$(document).on('click', '.edit-branch-btn', function() {
    var button = $(this);
    var branchId = button.data('branch-id');
    var branchCode = button.data('branch-code') || '';
    var branchName = button.data('branch-name') || '';
    var openDate = button.data('open-date') || '';
    var address = button.data('address') || '';
    var city = button.data('city') || '';
    var state = button.data('state') || '';
    var pinCode = button.data('pin-code') || 0;
    var managerId = button.data('manager-id') || 0;

    $('#editBranchId').val(branchId);
    $('#editBranchCode').val(branchCode);
    $('#editBranchName').val(branchName);
    $('#editOpenDate').val(openDate);
    $('#editBranchAddress').val(address);
    $('#editCity').val(city);
    $('#editState').val(state);
    $('#editPinCode').val(pinCode);
    
    // Set manager after dropdown is loaded
    $('#editBranchModal').one('shown.bs.modal', function() {
        if (managerId && managerId > 0) {
            $('#editBranchManager').val(managerId);
        }
    });
    
    $('#editBranchModal').modal('show');
});

function updateBranch() {
    // Validate required fields
    var branchCode = $('#editBranchCode').val().trim();
    var branchName = $('#editBranchName').val().trim();
    var address = $('#editBranchAddress').val().trim();
    var city = $('#editCity').val().trim();
    var state = $('#editState').val().trim();
    var pinCode = $('#editPinCode').val();
    
    if (!branchCode) {
        alert('Please enter branch code.');
        $('#editBranchCode').focus();
        return;
    }
    
    if (!branchName) {
        alert('Please enter branch name.');
        $('#editBranchName').focus();
        return;
    }
    
    if (!address) {
        alert('Please enter branch address.');
        $('#editBranchAddress').focus();
        return;
    }
    
    if (!city) {
        alert('Please enter city.');
        $('#editCity').focus();
        return;
    }
    
    if (!state) {
        alert('Please enter state.');
        $('#editState').focus();
        return;
    }
    
    if (!pinCode || pinCode.toString().length !== 6) {
        alert('Please enter a valid 6-digit PIN code.');
        $('#editPinCode').focus();
        return;
    }
    
    var branchData = {
        BranchID: $('#editBranchId').val(),
        BranchCode: branchCode,
        BranchName: branchName,
        OpenDate: $('#editOpenDate').val() || '',
        BAddress: address,
        City: city,
        State: state,
        PinCode: parseInt(pinCode),
        ManagerID: $('#editBranchManager').val() || 0
    };
    
    // Create the UserModel string format expected by the controller
    var userModel = branchData.BranchID + ',' + branchData.BranchCode + ',' + 
                   branchData.BranchName + ',' + branchData.OpenDate + ',' + 
                   branchData.BAddress + ',' + branchData.City + ',' + 
                   branchData.State + ',' + branchData.PinCode + ',' + branchData.ManagerID;
    
    // Show loading state
    var $updateBtn = $('.btn-success[onclick="updateBranch()"]');
    var originalText = $updateBtn.html();
    $updateBtn.html('<i class="fas fa-spinner fa-spin me-1"></i>Updating...').prop('disabled', true);
    
    $.ajax({
        url: '/Staff/EditBranch',
        type: 'GET',
        data: { UserModel: userModel },
        timeout: 10000, // 10 seconds timeout
        success: function(result) {
            if (result === 'Success') {
                $('#editBranchModal').modal('hide');
                
                // Show success message
                var successHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                '<i class="fas fa-check-circle me-2"></i>Branch updated successfully!' +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                '</div>';
                $('.container-fluid .card-body').prepend(successHtml);
                
                // Auto dismiss after 3 seconds
                setTimeout(function() {
                    $('.alert-success').fadeOut();
                }, 3000);
                
                // Reload the page to show updated data
                setTimeout(function() {
                    location.reload();
                }, 1500);
            } else {
                alert('Error updating branch: ' + result);
            }
        },
        error: function(xhr, status, error) {
            alert('Error updating branch: ' + error);
            console.log('Error details:', xhr.responseText);
        },
        complete: function() {
            // Reset button state
            $updateBtn.html(originalText).prop('disabled', false);
        }
    });
}

function deleteBranch(id, name) {
    if (confirm("Are you sure you want to delete branch '" + name + "'?")) {
        alert("Delete branch " + name + " (ID: " + id + ") - functionality to be implemented");
    }
}
</script>
}

<!-- Edit Branch Modal -->
<div class="modal fade" id="editBranchModal" tabindex="-1" aria-labelledby="editBranchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="editBranchModalLabel">
                    <i class="fas fa-building-edit me-2"></i>Edit Branch
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editBranchForm">
                    <input type="hidden" id="editBranchId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editBranchCode" class="form-label">Branch Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editBranchCode" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editBranchName" class="form-label">Branch Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editBranchName" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editOpenDate" class="form-label">Open Date</label>
                            <input type="text" class="form-control" id="editOpenDate" placeholder="DD/MM/YYYY">
                        </div>
                        <div class="col-md-6">
                            <label for="editBranchManager" class="form-label">Branch Manager</label>
                            <select class="form-select" id="editBranchManager">
                                <option value="">-- Select Manager --</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="editBranchAddress" class="form-label">Branch Address <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="editBranchAddress" rows="3" required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="editCity" class="form-label">City <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editCity" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editState" class="form-label">State <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editState" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editPinCode" class="form-label">PIN Code <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editPinCode" maxlength="6" required>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" onclick="updateBranch()">
                    <i class="fas fa-save me-1"></i>Update Branch
                </button>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Load staff list for manager dropdown when modal is shown
    $('#editBranchModal').on('show.bs.modal', function() {
        var branchId = $(this).data('branchId');
        $(this).data('branchId', branchId); // Store the branchId for later use
        
        // Load staff list first, then load branch data
        loadStaffList(function() {
            // Callback after staff list is loaded
            if (branchId) {
                loadBranchData(branchId);
            }
        });
    });
    
    // PIN code validation
    $('#editPinCode').on('input', function() {
        var value = $(this).val();
        if (value.length > 6) {
            $(this).val(value.slice(0, 6));
        }
    });
    
    // Form validation
    $('#editBranchForm input, #editBranchForm textarea, #editBranchForm select').on('blur', function() {
        validateField($(this));
    });
});

function validateField($field) {
    var value = $field.val().trim();
    var isValid = true;
    
    if ($field.attr('required') && !value) {
        isValid = false;
    }
    
    if ($field.attr('id') === 'editPinCode' && value && (value.length !== 6 || !/^\d{6}$/.test(value))) {
        isValid = false;
    }
    
    if (isValid) {
        $field.removeClass('is-invalid').addClass('is-valid');
    } else {
        $field.removeClass('is-valid').addClass('is-invalid');
    }
    
    return isValid;
}

function loadStaffList(callback) {
    $.ajax({
        url: '/Staff/GetStaffList',
        type: 'GET',
        success: function(data) {
            var dropdown = $('#editBranchManager');
            dropdown.empty();
            dropdown.append('<option value="">-- Select Manager --</option>');
            
            if (data && data.length > 0) {
                $.each(data, function(index, staff) {
                    dropdown.append('<option value="' + staff.Value + '">' + staff.Text + '</option>');
                });
                console.log('Staff list loaded successfully with ' + data.length + ' items');
            } else {
                console.log('No staff members found');
            }
            
            // Call the callback function if provided
            if (typeof callback === 'function') {
                callback();
            }
        },
        error: function(xhr, status, error) {
            console.error('Error loading staff list:', error);
            $('#editBranchManager').html('<option value="">Error loading staff</option>');
            
            // Still call callback even on error
            if (typeof callback === 'function') {
                callback();
            }
        }
    });
}

function loadBranchData(branchId) {
    // Show loading state in the modal
    $('#editBranchCode').val('Loading...');
    $('#editBranchName').val('Loading...');
    $('#editBranchAddress').val('Loading...');
    $('#editCity').val('Loading...');
    $('#editState').val('Loading...');
    
    // Fetch branch details via AJAX
    $.ajax({
        url: '/Staff/GetBranch',
        type: 'GET',
        data: { id: branchId },
        success: function(response) {
            if (response.success) {
                // Populate form fields
                $('#editBranchCode').val(response.BranchCode || '');
                $('#editBranchName').val(response.BranchName || '');
                $('#editOpenDate').val(response.OpenDate || '');
                $('#editBranchAddress').val(response.BAddress || '');
                $('#editCity').val(response.City || '');
                $('#editState').val(response.State || '');
                $('#editPinCode').val(response.PinCode || '');
                
                // Set manager - ensure dropdown is populated first
                if (response.ManagerID && response.ManagerID > 0) {
                    // Check if the option exists in the dropdown
                    var managerOption = $('#editBranchManager option[value="' + response.ManagerID + '"]');
                    if (managerOption.length > 0) {
                        $('#editBranchManager').val(response.ManagerID);
                        console.log('Manager set to:', response.ManagerID);
                    } else {
                        console.log('Manager ID not found in dropdown:', response.ManagerID);
                        console.log('Available options:', $('#editBranchManager option').length);
                    }
                } else {
                    console.log('No manager assigned to this branch');
                }
                
                console.log('Branch data loaded successfully for branch ID:', branchId);
            } else {
                alert('Error: ' + response.message);
                $('#editBranchModal').modal('hide');
            }
        },
        error: function(xhr, status, error) {
            alert('Error loading branch details: ' + error);
            console.error('Branch data loading error:', xhr.responseText);
            $('#editBranchModal').modal('hide');
        }
    });
}
</script>

<style>
.card {
    border: none;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.table th {
    border-top: none;
    font-weight: 600;
}

.badge {
    font-size: 0.875em;
}

.btn-group .btn {
    border-radius: 0.25rem;
    margin: 0 1px;
}

@@media (max-width: 768px) {
    .container-fluid {
        padding: 10px;
    }
    
    .card-body {
        padding: 1rem;
    }
    
    .table-responsive {
        font-size: 0.875rem;
    }
}
</style>
