<script type="text/javascript">
    var datePickerActive = false;

    // Helper function to format date as yyyy-MM-dd (ISO 8601)
    function formatDate(date) {
        var d = new Date(date),
            month = '' + (d.getMonth() + 1),
            day = '' + d.getDate(),
            year = d.getFullYear();

        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;

        return [year, month, day].join('-');
    }

    $("#idDOD").on("focus", function () {
        if (!datePickerActive) {
            datePickerActive = true;
            $("#idDOD").attr("type", "date");
        }
    });

    $("#idDOD").on("blur", function () {
        if ($('#idDOD').val() == '') {
            datePickerActive = false;
            $("#idDOD").attr("type", "text");
            $('#idDOD').attr("placeholder", "Select Date");
        }
    });

    $(document).ready(function () {
        if ('@Session["LoanLaterDisbusMbrID"]' != '') {
            $("#MbrID").val('@Session["LoanLaterDisbusMbrID"]');
        }

        if ('@Session["SavedMbrID"]' != '') {
            $("#MbrID").val('@Session["SavedMbrID"]');
        }

        $("#idDOD").change(function () {
            $("#lblmgs").html('');
            if ($('#idDOD').val().length == 0) {
                return;
            }
            else {
                var today = new Date();
                var frmDt = new Date($('#idDOD').val());
                if (frmDt.getDate() > today.getDate() && frmDt.getMonth() > today.getMonth() && frmDt.getFullYear() == today.getFullYear()) {
                    $("#lblmgs").html("<h3 style='color: white; background: linear-gradient(45deg, #fed7d7, #feb2b2);'>Future date is not allowed.</h3>");
                }
                else {
                    $('#DOD').val(formatDate(frmDt));
                    $("#lblmgs").html('');
                }
            }
        });

        $("#AdvancedEMI").change(function () {
            var PaidWeeks = $('#AdvancedEMI').val();
            var today = new Date();
            var DODDt = new Date($('#idDOD').val());

            if (PaidWeeks != '' && parseInt(PaidWeeks) > 0) {
                PaidWeeks = parseInt(PaidWeeks) + 1;
                var iDay = parseInt(PaidWeeks) * 7;

                var dat = new Date(DODDt);
                dat.setDate(dat.getDate() + iDay);

                $('#NextDueDt').val(formatDate(dat));
            }
        });

        if ('@Model.IsSucess' == "NewMbr") {
            // New member flow
        }
        else if ('@Model.IsSucess' == "1") {
            $("#lblmgs").html("<h3 style='color: white; background: linear-gradient(45deg, #48bb78, #38a169);'>Successfully Saved Loan Details For Member: " + '@Model.Savings' + "</h3>");
            $('#myform')[0].reset();
        }
        else if ('@Model.IsSucess' == "2") {
            $("#lblmgs").html("<h3 style='color: white; background: linear-gradient(45deg, #f56565, #e53e3e);'>Failed To Save Loan Details. Please try again.</h3>");
        }
        else if ('@Model.IsSucess' == "Exist") {
            $("#lblmgs").html("<h3 style='color: white; background: linear-gradient(45deg, #ed8936, #dd6b20);'>This type of loan is already disbursed.</h3>");
        }
        else if ('@Model.IsSucess' == "L") {
            $("#lblmgs").html("<h3 style='color: white; background: linear-gradient(45deg, #f56565, #e53e3e);'>Member already has an active loan.</h3>");
            bootbox.alert("Member Already Has Active Loan");
        }
        else if ('@Model.IsSucess' == "ValidationError") {
            $("#lblmgs").html("<h3 style='color: white; background: linear-gradient(45deg, #f56565, #e53e3e);'>Please correct the validation errors below.</h3>");
            $('#validation-summary').show();
            
            // Scroll to first validation error
            var firstError = $('.field-validation-error:visible').first();
            if (firstError.length > 0) {
                $('html, body').animate({
                    scrollTop: firstError.offset().top - 100
                }, 500);
            }
        }

        // Check if there are server-side validation errors and show them
        if ($('.field-validation-error').filter(function() { return $(this).text().trim() !== ''; }).length > 0) {
            $('#validation-summary').show();
            $('.field-validation-error').filter(function() { 
                return $(this).text().trim() !== ''; 
            }).each(function() {
                var fieldId = $(this).prev('.modern-input, .modern-select').attr('id') || 
                             $(this).parent().find('.modern-input, .modern-select').attr('id');
                if (fieldId) {
                    $('#' + fieldId).addClass('input-validation-error');
                }
            }).show();
        }
    });

    $("#btnCancel").click(function () {
        $("form")[0].reset();
    });

    // Enhanced field interactions with modern styling
    function setupFieldInteractions(fieldId, defaultValue) {
        $("#" + fieldId).on("focus", function () {
            if ($(this).val() == defaultValue) {
                $(this).val('').addClass('field-focused');
            }
        });

        $("#" + fieldId).on("blur", function () {
            if ($(this).val() == "") {
                $(this).val(defaultValue).removeClass('field-focused');
            }
        });
    }

    setupFieldInteractions("Loan_Amount", "0.00");
    setupFieldInteractions("NoOfDays", "0");
    setupFieldInteractions("GRFAmt", "0.00");
    setupFieldInteractions("Insurance", "0.00");
    setupFieldInteractions("Processing_Fee", "0.00");
    setupFieldInteractions("RateOfInterest", "0.00");
    setupFieldInteractions("Other_Income", "0.00");
    setupFieldInteractions("AdvancedEMI", "0");

    $("#btnSave").click(function () {
        // Clear previous validation messages
        clearValidationMessages();
        
        var isValid = true;
        var errors = [];
        
        // Validate Member Selection
        if ($("#drMbrId").val() == "" || $("#drMbrId").val() == null) {
            showFieldError("drMbrId", "Please select a member");
            errors.push("Please select a member");
            isValid = false;
        }
        
        // Validate Loan Amount
        var loanAmount = parseFloat($("#Loan_Amount").val()) || 0;
        if (loanAmount <= 0) {
            showFieldError("Loan_Amount", "Please enter a valid loan amount");
            errors.push("Loan amount must be greater than 0");
            isValid = false;
        }

        // Validate No Of Days
        var noOfDays = parseInt($("#NoOfDays").val()) || 0;
        if (noOfDays <= 0) {
            showFieldError("NoOfDays", "Please enter number of days/weeks");
            errors.push("Number of days/weeks must be greater than 0");
            isValid = false;
        }

        // Validate Disbursement Date
        if ($("#idDOD").val().length == 0) {
            showFieldError("idDOD", "Please select disbursement date");
            errors.push("Please select disbursement date");
            isValid = false;
        }

        // Validate Principal EMI
        var prinEMI = parseFloat($("#Prin_EMI").val()) || 0;
        if (prinEMI <= 0) {
            showFieldError("Prin_EMI", "Principal EMI must be calculated");
            errors.push("Principal EMI must be greater than 0");
            isValid = false;
        }

        // Validate Interest Amount
        var interest = parseFloat($("#RateOfInterest").val()) || 0;
        if (interest <= 0) {
            showFieldError("RateOfInterest", "Please enter total interest amount");
            errors.push("Total interest amount must be greater than 0");
            isValid = false;
        }

        // Validate End Date
        if ($("#Expiry_Date").val().length == 0) {
            showFieldError("Expiry_Date", "End date must be calculated");
            errors.push("End date is required");
            isValid = false;
        }

        // Validate Loan Type
        var loanType = $("#LoanType option:selected").val();
        if (loanType == "" || loanType == '-Select Loan Type-') {
            showFieldError("LoanType", "Please select loan type");
            errors.push("Please select loan type");
            isValid = false;
        }

        // Validate Next Due Date
        if ($("#NextDueDt").val().length == 0) {
            showFieldError("NextDueDt", "Next due date must be calculated");
            errors.push("Next due date is required");
            isValid = false;
        }

        if (!isValid) {
            showValidationSummary(errors);
            // Scroll to first error
            var firstError = $('.input-validation-error').first();
            if (firstError.length > 0) {
                $('html, body').animate({
                    scrollTop: firstError.offset().top - 100
                }, 500);
            }
        }
        else {
            // If client-side validation passes, trigger server-side validation
            $("#btnSbmt").trigger("click");
        }
    });

    function clearValidationMessages() {
        $('.field-validation-error').hide().text('');
        $('.input-validation-error').removeClass('input-validation-error');
        $('#validation-summary').hide();
        $('#client-validation-list').empty();
    }

    function showFieldError(fieldId, message) {
        $('#' + fieldId).addClass('input-validation-error');
        var validationSpan = $('#' + fieldId).next('.field-validation-error');
        if (validationSpan.length === 0) {
            validationSpan = $('#' + fieldId).parent().next('.field-validation-error');
        }
        if (validationSpan.length > 0) {
            validationSpan.text(message).show();
        }
    }

    function showValidationSummary(errors) {
        var errorList = $('#client-validation-list');
        errorList.empty();
        
        errors.forEach(function(error) {
            errorList.append('<li>' + error + '</li>');
        });
        
        $('#validation-summary').show();
    }

    // Enhanced form submission with validation
    $("form").submit(function(e) {
        if (!$(this).valid()) {
            e.preventDefault();
            showValidationSummary(["Please correct the highlighted errors before submitting."]);
            return false;
        }
    });

    // Real-time validation on blur
    $("input[required], select[required]").blur(function() {
        var fieldId = $(this).attr('id');
        var value = $(this).val();
        
        if (value === "" || value === "0" || value === "0.00") {
            var fieldName = $(this).prev('label').text().replace(/[^a-zA-Z\s]/g, '');
            showFieldError(fieldId, fieldName + " is required");
        } else {
            $(this).removeClass('input-validation-error');
            $(this).next('.field-validation-error').hide();
        }
    });

    // Clear validation on focus
    $("input, select").focus(function() {
        $(this).removeClass('input-validation-error');
        $(this).next('.field-validation-error').hide();
    });

    $("#idDOD").focusout(function () {
        if ($(this).val()) {
            var newDt = new Date($(this).val());
            var vDays = parseInt($("#NoOfDays").val() || 0) * 7;
            
            // Calculate Principal EMI
            var loanAmount = parseFloat($("#Loan_Amount").val() || 0);
            var numDays = parseInt($("#NoOfDays").val() || 1);
            if (loanAmount > 0 && numDays > 0) {
                $("#Prin_EMI").val(Math.round(loanAmount / numDays));
            }

            // Calculate End Date
            if (vDays > 0) {
                newDt.setDate(newDt.getDate() + vDays);
                $("#Expiry_Date").val(formatDate(newDt));
            }

            // Calculate Next Due Date (7 days from disbursement)
            var nextDue = new Date($(this).val());
            nextDue.setDate(nextDue.getDate() + 7);
            $('#NextDueDt').val(formatDate(nextDue));
        }
    });

    $("#bAdvancedEMI").change(function () {
        if ($(this).is(':checked')) {
            $('#dvPrePaid').slideDown(300);
        }
        else {
            $('#dvPrePaid').slideUp(300);
        }
    });

    $("#GrpCode").change(function () {
        loadData();
        var mbr = $("#drMbrId :selected").val();
        $("#MbrID").val(mbr);
    });

    $("#drMbrId").change(function () {
        var mbr = $("#drMbrId :selected").val();
        $("#MbrID").val(mbr);
    });

    // Enhanced AJAX with loading states
    function loadData() {
        var selectedGrpCode = $("#GrpCode :selected").val();
        
        $("#drMbrId").prop('disabled', true).html('<option>Loading...</option>');

        $.ajax({
            url: '@Url.Action("GetLoanMemberList", "Loans")',
            type: "GET",
            contentType: "application/json;charset=utf-8",
            async: true,
            data: { sGrpCode: selectedGrpCode },
            catch: false,
            dataType: "json",
            success: function (res) {
                $("#drMbrId").empty().prop('disabled', false);
                $("#drMbrId").append('<option value="">-- Select Member --</option>');
                $.each(res, function (index, item) {
                    $("#drMbrId").append($('<option></option>').text(item.Text).val(item.Value));
                });
                var mbr = $("#drMbrId :selected").val();
                $("#MbrID").val(mbr);
            },
            error: function (errormessage) {
                $("#drMbrId").prop('disabled', false).html('<option value="">Error loading members</option>');
                bootbox.alert("Error loading members: " + errormessage.responseText);
            }
        });
    }
</script>